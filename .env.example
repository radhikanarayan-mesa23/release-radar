# --- Data ---
DATABASE_URL=                 # Neon pooled connection string (Vercel → Storage → Neon sets this automatically)
GITHUB_TOKEN=                 # fine-grained, public repositories read-only

# --- AI (exam rule: Gemini Flash only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash # use the current Flash model listed in Google AI Studio

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=Release Radar <onboarding@resend.dev>   # change to an address on your verified domain to email teammates
DIGEST_TO=                    # Keerthi's inbox (your email for the demo)

# --- Access & schedule ---
ADMIN_PASSCODE=               # unlocks add/delete/run/assign/status
CRON_SECRET=                  # Vercel Cron sends it as a Bearer token
APP_URL=                      # https://<project>.vercel.app (links in emails)

# --- Cost tracking (₹ per 1K tokens, edit to current pricing) ---
COST_GEMINI_INR_PER_1K_INPUT=0.025
COST_GEMINI_INR_PER_1K_OUTPUT=0.21
